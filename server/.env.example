# Server port (default 4001)
PORT=4001

# PurpleAir (required for Air quality tab in dashboard)
# Get a READ key from https://www.purpleair.com/ (account/API)
PURPLEAIR_READ_KEY=BC86667A-1CF0-11F1-B596-4201AC1DC123

# Optional: comma-separated sensor IDs from the PurpleAir map
# PURPLEAIR_SENSOR_IDS=12345,67890

# Optional: filter sensors by name (used if PURPLEAIR_SENSOR_IDS not set)
# PURPLEAIR_NAME_FILTER=InnovationCenterPurple

# Supabase (optional – for /api/moods; dashboard uses Supabase from frontend)
# From Supabase project: Settings → API → Project URL and service_role key
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
